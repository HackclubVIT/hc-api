generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// HC MAIN MODELS (DO NOT MODIFY)
// ==========================================

model User {
  id                 BigInt  @id
  name               String
  email              String? @unique
  password           String?
  role               String  @default("Member")
  department         String?
  status             String  @default("Active")
  isReviewer         Boolean @default(false)
  projectsUploaded   Int     @default(0)
  averageRating      String  @default("0.0")
  badges             Json    @default("[]")
  recentProjects     Json    @default("[]")
  projectRatingScore Int     @default(0)
  contributionScore  Int     @default(10)
  eventScore         Int     @default(5)
  totalScore         Int     @default(7)
  registerNumber     String?
  phoneNumber        String?
  location           String?
  joined             String?
  github             String?
  portfolio          String?
  avatar             String?
  isRecruitmentAdmin Boolean @default(false)
  permissions        Json    @default("[]")

  // Relations to recruitment models
  recruitmentRole    RecruitmentRoleAssignment?
  recruitmentPanels  RecruitmentPanelMember[]
  recruitmentNotifs  RecruitmentNotification[]
  recruitmentAudit   RecruitmentAuditLog[]
  recruitmentNotes   RecruitmentNote[]
  scheduledInterviews RecruitmentInterview[] @relation("RecruiterInterviews")

  @@map("users")
}

model Project {
  id                BigInt  @id
  title             String
  description       String?
  category          String  @default("Web Development")
  problemStatement  String?
  solution          String?
  screenshots       Json    @default("[]")
  demoVideoUrl      String?
  github            String?
  deployment        String?
  status            String  @default("PENDING_REVIEW")
  owner             String?
  rating            String  @default("0.0")
  ratingCount       Int     @default(0)
  contributors      String?
  submissionDate    String?
  technologiesUsed  Json    @default("[]")
  awards            Json    @default("[]")
  individualRatings Json    @default("[]")

  @@map("projects")
}

model ProjectRating {
  id        BigInt   @id
  projectId BigInt
  adminId   BigInt
  adminName String
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, adminId])
  @@map("project_ratings")
}

model RecruitmentApplication {
  id                         BigInt  @id
  recruitmentId              String  @default("recruitment-2026")
  name                       String
  registerNumber             String
  email                      String
  phoneNumber                String?
  domain                     String?
  firstPreference            String?
  secondPreference           String?
  firstPrefReason            String?
  secondPrefReason           String?
  yearOfStudy                String
  technicalSkills            Json?   @default("[]")
  skillLevel                 String?
  github                     String?
  linkedin                   String?
  portfolio                  String?
  sevenDaysBuild             String?
  skillToLearn               String?
  whyHackclub                String?
  expectations               String?
  productiveWebsiteQuestions String?
  threeDaysProjectTradeoffs  String?
  anythingElse               String?
  whyJoin                    String?
  projectDetails             String?
  status                     String  @default("Pending")
  appliedDate                String?

  decided_by         BigInt?
  decided_at                 DateTime?
  decision_reason            String?

  // Recruitment relations
  interviews                 RecruitmentInterview[]
  formSubmission             RecruitmentFormSubmission?
  notes                      RecruitmentNote[]

  @@index([recruitmentId])
  @@index([status])
  @@index([domain])
  @@unique([recruitmentId, email])
  @@unique([recruitmentId, registerNumber])
  @@map("recruitment_applications")
}

model AllowedEmail {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())

  @@map("allowed_emails")
}

model Collection {
  name String @id
  data Json

  @@map("collections")
}

// ==========================================
// RECRUITMENT SPECIFIC MODELS
// ==========================================

model RecruitmentRoleAssignment {
  id          Int      @id @default(autoincrement())
  user_id     BigInt   @unique
  role        String   @default("NONE") // ADMIN, RECRUITER, PANEL_MEMBER, NONE
  departments String[] // For RECRUITER role
  active      Boolean  @default(true) // For disabling user access
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])

  @@index([role])
  @@map("recruitment_role_assignments")
}

model RecruitmentForm {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  published_at DateTime?
  closed_at    DateTime?

  questions    RecruitmentFormQuestion[]
  submissions  RecruitmentFormSubmission[]

  @@map("recruitment_forms")
}

model RecruitmentFormQuestion {
  id       Int      @id @default(autoincrement())
  form_id  Int
  question String
  type     String
  required Boolean  @default(true)
  options  String[] // Using String[] for options

  form     RecruitmentForm @relation(fields: [form_id], references: [id])
  answers  RecruitmentFormAnswer[]

  @@map("recruitment_form_questions")
}

model RecruitmentFormSubmission {
  id              Int      @id @default(autoincrement())
  application_id  BigInt   @unique
  form_id         Int
  submitted_at    DateTime @default(now())

  application     RecruitmentApplication @relation(fields: [application_id], references: [id])
  form            RecruitmentForm        @relation(fields: [form_id], references: [id])
  answers         RecruitmentFormAnswer[]

  @@map("recruitment_form_submissions")
}

model RecruitmentFormAnswer {
  id              Int      @id @default(autoincrement())
  submission_id   Int
  question_id     Int
  answer          String
  
  submission      RecruitmentFormSubmission @relation(fields: [submission_id], references: [id])
  question        RecruitmentFormQuestion   @relation(fields: [question_id], references: [id])

  @@map("recruitment_form_answers")
}

model RecruitmentNote {
  id              Int      @id @default(autoincrement())
  application_id  BigInt
  author_id       BigInt
  content         String
  created_at      DateTime @default(now())

  application     RecruitmentApplication @relation(fields: [application_id], references: [id])
  author          User                   @relation(fields: [author_id], references: [id])

  @@map("recruitment_notes")
}

model RecruitmentPanel {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())

  members     RecruitmentPanelMember[]
  interviews  RecruitmentInterview[]

  @@map("recruitment_panels")
}

model RecruitmentPanelMember {
  id       Int    @id @default(autoincrement())
  panel_id Int
  user_id  BigInt
  active   Boolean @default(true)

  panel    RecruitmentPanel @relation(fields: [panel_id], references: [id])
  user     User             @relation(fields: [user_id], references: [id])
  
  feedback             RecruitmentFeedback[]
  assigned_interviews  RecruitmentInterview[] @relation("InterviewAssignments")

  @@map("recruitment_panel_members")
}

model RecruitmentInterview {
  id             Int      @id @default(autoincrement())
  application_id BigInt
  panel_id       Int
  recruiter_id   BigInt?
  round          Int      @default(1)
  date           DateTime
  start_time     DateTime
  end_time       DateTime
  meeting_link   String?
  status         String   @default("SCHEDULED")

  application    RecruitmentApplication @relation(fields: [application_id], references: [id])
  panel          RecruitmentPanel       @relation(fields: [panel_id], references: [id])
  recruiter      User?                  @relation("RecruiterInterviews", fields: [recruiter_id], references: [id])
  
  feedback         RecruitmentFeedback[]
  assigned_members RecruitmentPanelMember[] @relation("InterviewAssignments")

  @@index([application_id])
  @@index([date])
  @@map("recruitment_interviews")
}

model RecruitmentFeedback {
  id                   Int      @id @default(autoincrement())
  interview_id         Int
  panel_member_id      Int
  technical_score      Int
  communication_score  Int
  problem_solving_score Int
  confidence_score     Int
  teamwork_score       Int
  comments             String?
  decision             String

  interview            RecruitmentInterview   @relation(fields: [interview_id], references: [id])
  panel_member         RecruitmentPanelMember @relation(fields: [panel_member_id], references: [id])

  @@index([interview_id])
  @@unique([interview_id, panel_member_id])
  @@map("recruitment_feedback")
}

model RecruitmentNotification {
  id         Int      @id @default(autoincrement())
  user_id    BigInt
  title      String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("recruitment_notifications")
}

model RecruitmentAuditLog {
  id         Int      @id @default(autoincrement())
  user_id    BigInt?
  action     String
  entity     String
  entity_id  String?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [user_id], references: [id])

  @@index([timestamp])
  @@map("recruitment_audit_logs")
}

model RecruitmentEmailLog {
  id              Int      @id @default(autoincrement())
  event_type      String
  entity_id       String?
  recipient_count Int
  status          String
  error_message   String?
  timestamp       DateTime @default(now())

  @@index([timestamp])
  @@map("recruitment_email_logs")
}

model RecruitmentAnnouncement {
  id            Int      @id @default(autoincrement())
  department    String
  target_status String   @default("SHORTLISTED")
  title         String
  message       String
  created_by    String?
  created_at    DateTime @default(now())

  @@index([department])
  @@map("recruitment_announcements")
}
